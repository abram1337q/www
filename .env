# ===================================
# КОНФИГУРАЦИЯ ПРОЕКТА "СЛЕД НА ЗЕМЛЕ"
# ===================================
# Скопируйте этот файл как .env и заполните значения

# === БАЗА ДАННЫХ ===
# PostgreSQL строка подключения (сервер в РФ)
DATABASE_URL="postgresql://neondb_owner:npg_IchjX5ezEU2G@ep-withered-bird-a8nxftrq-pooler.eastus2.azure.neon.tech/neondb?sslmode=require&channel_binding=require"

# === ЮKASSA ===
# Идентификатор магазина
YOOKASSA_SHOP_ID="your_shop_id"
# Секретный ключ
YOOKASSA_SECRET_KEY="your_secret_key"
# Сумма платежа в копейках (990₽ = 99000)
PAYMENT_AMOUNT="990"
# URL для возврата после оплаты
PAYMENT_RETURN_URL="https://your-domain.ru/payment/success"

# === EMAIL ===
# SMTP сервер (Yandex / Mail.ru)
SMTP_HOST="smtp.yandex.ru"
SMTP_PORT="465"
SMTP_USER="noreply@your-domain.ru"
SMTP_PASS="your_smtp_password"
SMTP_FROM="История моей жизни <noreply@your-domain.ru>"

# === S3 ХРАНИЛИЩЕ ===
# S3-совместимое хранилище (Yandex Object Storage)
S3_ENDPOINT="https://storage.yandexcloud.net"
S3_REGION="ru-central1"
S3_BUCKET="sled-na-zemle-uploads"
S3_ACCESS_KEY="your_access_key"
S3_SECRET_KEY="your_secret_key"

# === MAPTILER ===
# API ключ MapTiler (https://maptiler.com)
NEXT_PUBLIC_MAPTILER_KEY=mPPzSxB0vb10BwyxYoj9

# === БЕЗОПАСНОСТЬ ===
# Секретный ключ для JWT токенов админки (64+ символов)
JWT_SECRET="your_very_long_secret_key_at_least_64_characters_for_security"
# Соль для генерации токенов кабинета
CABINET_TOKEN_SALT="your_cabinet_token_salt"

# === ПРИЛОЖЕНИЕ ===
# URL сайта
NEXT_PUBLIC_APP_URL="https://your-domain.ru"
# Название сайта
NEXT_PUBLIC_APP_NAME="История моей жизни"
